{
  "manifest_version": 3,
  "name": "Bitbucket Diff Enhancer",
  "version": "1.11.0",
  "description": "Extract Bitbucket Cloud PR diffs as readable unified-diff text and hide bot or resolved comments from pull requests.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://bitbucket.org/*",
    "https://api.bitbucket.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://bitbucket.org/*"
      ],
      "js": [
        "lib/core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
